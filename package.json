{
  "scripts": {
    "build": "zile",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version",
    "check": "vp lint --fix --ignore-pattern package.json && vp fmt src test examples playgrounds",
    "check:types": "tsc -b && pnpm -r --filter=!wata check:types",
    "dev": "zile dev",
    "test": "vp test",
    "test:browser": "vp test --project browser",
    "test:node": "vp test --project node",
    "vp": "vp"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vp": "catalog:",
    "zile": "catalog:"
  },
  "packageManager": "pnpm@11.1.0",
  "[!start-pkg]": "",
  "name": "wata",
  "type": "module",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@noble/ciphers": "catalog:",
    "@noble/hashes": "catalog:",

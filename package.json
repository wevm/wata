      "default": "./dist/consumer/transports/webhookCallback.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "src": "./src/host/index.ts",
      "react-native": "./dist/host/index.js",
      "default": "./dist/host/index.js"
    },
    "./host/transports/deviceCode": {
      "types": "./dist/host/transports/deviceCode.d.ts",
      "src": "./src/host/transports/deviceCode.ts",
      "react-native": "./dist/host/transports/deviceCode.js",
      "default": "./dist/host/transports/deviceCode.js"
    },
    "./host/transports/mobileWebAuth": {

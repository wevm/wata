{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "example-host-web",
  "compatibility_date": "2026-05-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/.well-known/urpc/*",
      "/auth/device",
      "/auth/device/*",
      "/auth/mobile",
      "/auth/mobile/*",
    ],
  },
}

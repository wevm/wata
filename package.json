      "types": "./dist/host/transports/webhookCallback.d.ts",
      "src": "./src/host/transports/webhookCallback.ts",
      "react-native": "./dist/host/transports/webhookCallback.js",
      "default": "./dist/host/transports/webhookCallback.js"
    },
    "./identity": {
